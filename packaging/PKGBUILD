# Maintainer: bhimio1
pkgname=material-3-calendar-git
pkgver=0.1.0
pkgrel=1
pkgdesc="Material 3 calendar: Google, Microsoft, iCloud, CalDAV and local calendars with a sync daemon"
arch=('x86_64' 'aarch64')
url="https://github.com/bhimio1/material-3-calendar"
license=('MIT')
depends=('libxkbcommon' 'wayland' 'libglvnd' 'libsecret' 'xdg-utils' 'dbus')
makedepends=('cargo' 'git')
optdepends=(
  'gnome-keyring: a Secret Service keyring for sign-in tokens (or KeePassXC / KWallet)'
  'zenity: file chooser for .ics import'
)
provides=('material-3-calendar')
conflicts=('material-3-calendar' 'material-3-calendar-bin')
source=("$pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$pkgname"
  printf "0.1.0.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen
}

package() {
  cd "$pkgname"
  install -Dm755 target/release/m3-calendar "$pkgdir/usr/bin/m3-calendar"
  install -Dm644 packaging/material_3_calendar.desktop "$pkgdir/usr/share/applications/material_3_calendar.desktop"
  install -Dm644 packaging/m3-calendar.service "$pkgdir/usr/lib/systemd/user/m3-calendar.service"
  install -Dm644 packaging/org.material3.Calendar.service "$pkgdir/usr/share/dbus-1/services/org.material3.Calendar.service"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 assets/LICENSE-Inter.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE-Inter.txt"
}
